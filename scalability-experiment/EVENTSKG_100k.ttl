    terms:issued "2008-01-14"^^xsd:date ;
    terms:modified "2008-01-14"^^xsd:date ;
    rdfs:comment "The file format, physical medium, or dimensions of the resource."@en ;
    rdfs:isDefinedBy terms: ;
